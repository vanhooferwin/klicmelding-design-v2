# ---- App ----
NODE_ENV=production
AUTH_SECRET=               # genereer: openssl rand -base64 32
AUTH_URL=https://www.klicmelding.nl

# ---- Database ----
# POSTGRES_PASSWORD wordt door docker-compose gebruikt voor de db-service én de DATABASE_URL
POSTGRES_PASSWORD=
DATABASE_URL=postgres://klic:CHANGE_ME@db:5432/klicmelding   # lokaal zonder Docker: @localhost:5432

# ---- Mailjet ----
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM="Klicmelding.nl <info@klicmelding.nl>"

# ---- Rabobank OmniKassa ----
OMNIKASSA_BASE_URL=        # sandbox-URL tijdens ontwikkeling
OMNIKASSA_REFRESH_TOKEN=
OMNIKASSA_SIGNING_KEY=

# ---- PDOK (adres-autofill) ----
PDOK_BASE_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1

# ---- Object-storage (rapporten) — MinIO / S3-compatible ----
S3_ENDPOINT=http://minio:9000      # in compose; extern bv. https://minio.klicmelding.nl
S3_REGION=eu-west-1
S3_BUCKET=klic-rapporten
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Optioneel: AI-assistent "Klickie" ----
ANTHROPIC_API_KEY=
